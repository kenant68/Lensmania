@page "/posts"
@inject HttpClient Http
@using LensmaniaLibrary.Models

<h1>Les photos</h1>

@if (posts == null)
{
    <p>Chargement...</p>
}
else if (!posts.Any())
{
    <p>Aucune photo pour l'instant.</p>
}
else
{
    @foreach (var post in posts)
    {
        <div>
            <img src="@post.PhotoUrl" alt="@post.Title" />
            <h3>@post.Title</h3>
            <p>@post.Description</p>
            <small>@post.CreatedAt.ToShortDateString()</small>
        </div>
    }
}

@code {
    private List<Post>? posts;

    protected override async Task OnInitializedAsync()
    {
        posts = await Http.GetFromJsonAsync<List<Post>>("http://localhost:5078/api/posts");
    }
}
