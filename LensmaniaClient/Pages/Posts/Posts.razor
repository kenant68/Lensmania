@page "/posts"
@using Soenneker.Blazor.Masonry

<h1>Lensmania</h1>

@if (_hasError && !_posts.Any())
{
    <p>Erreur lors du chargement des photos.</p>
}
else if (!_posts.Any() && _isLoading)
{
    <p>Chargement...</p>
}
else if (!_posts.Any())
{
    <p>Aucune photo pour l'instant.</p>
}
else
{
    <Masonry @key="_cursor" AutoRender="false" SizerClass="col-sm-1" @ref="_masonry" class="row">
        @foreach (var post in _posts)
        {
            <MasonryItem class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="post-card">
                    <img src="@post.PhotoUrl" alt="@post.Title" class="card-img-top" @onload="OnImageLoaded"
                         @onerror="OnImageFailed"/>
                    @* <div class="card-body"> *@
                    @*     <h3>@post.Title</h3> *@
                    @*     <p>@post.Description</p> *@
                    @*     <p>@post.CreatedAt.ToShortDateString()</p> *@
                    @* </div> *@
                </div>
            </MasonryItem>
        }
    </Masonry>
}

@if (_isLoading)
{
    <p>Chargement...</p>
}

@if (_hasError && _posts.Any())
{
<p>Impossible de charger plus de photos.</p>
}

@if (!_hasMore && _posts.Any())
{
    <p>Plus aucune photo à afficher.</p>
}

@if (_hasMore)
{
    <div @ref="_sentinel" style="height: 1px;"></div>
}
