@page "/profile/{UserId:int}"
@using LensmaniaLibrary.DTOs.Posts
@using System.Security.Claims
@using LensmaniaClient.Components
@using LensmaniaClient.Services.Auth
@inject AuthenticationStateProvider AuthStateProvider

<div class="profile-page">

    <header class="profile-header">
        <h1>
            @(_isOwnProfile 
                ? "Mon profil" 
                : $"Profil de {(_username ?? "...")}")
        </h1>
    </header>

    <Posts @ref="_postsComponent"
           UserId="UserId"
           DisplayCreateButton="_isOwnProfile"
           IsOwnProfile="_isOwnProfile"
    />

</div>

@code {
    [Parameter] public int UserId { get; set; }

    private Posts? _postsComponent;
    private bool _isOwnProfile;
    private string? _username;

    protected override async Task OnParametersSetAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = state.User;
        
        var userIdClaim = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
        _isOwnProfile = userIdClaim is not null && int.Parse(userIdClaim) == UserId;
        
        if (_isOwnProfile)
        {
            _username = user.FindFirst("name")?.Value
                        ?? user.FindFirst(ClaimTypes.Name)?.Value
                        ?? user.Identity?.Name;
        }
        // TODO: implement GetUserByIdAsync first
        // else
        // {
        //     var profile = await _userService.GetUserByIdAsync(UserId);
        //     _username = profile.Username;
        // }
    }
}
