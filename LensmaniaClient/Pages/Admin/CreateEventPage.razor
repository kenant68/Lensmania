@page "/admin/events/create"
@using LensmaniaLibrary.DTOs.Events
@using LensmaniaLibrary.DTOs.Badges
@using LensmaniaLibrary.DTOs.Themes
@using LensmaniaClient.Services
@using LensmaniaClient.Components
@inject EventService EventSvc
@inject ThemeService ThemeSvc
@inject NavigationManager Nav

<div class="create-event-page container py-4">

    <div class="page-header mb-4">
        <a href="/admin/events" class="btn btn-link btn-back ps-0">
            <i class="bi bi-arrow-left me-1"></i> Retour aux événements
        </a>
        <h1 class="page-title mt-1">Nouvel événement</h1>
        <p class="text-muted">Remplissez les informations ci-dessous pour créer un événement photo.</p>
    </div>

    @* Alert *@
    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@_errorMessage</span>
        </div>
    }

    @* Success *@
    @if (_createdEvent is not null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>L'événement <strong>@_createdEvent.Name</strong> a été créé avec succès !</span>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <h5 class="section-title">
                <i class="bi bi-info-circle me-2"></i>Informations générales
            </h5>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="event-name">
                    Nom de l'événement <span class="text-danger">*</span>
                </label>
                <input id="event-name"
                       type="text"
                       class="form-control @(ShowError("Name") ? "is-invalid" : "")"
                       placeholder="Ex : Festival de la lumière 2025"
                       @bind="_form.Name" />
                @if (ShowError("Name"))
                {
                    <div class="invalid-feedback">Le nom est obligatoire.</div>
                }
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold" for="event-description">
                    Description
                </label>
                <textarea id="event-description"
                          class="form-control"
                          rows="4"
                          placeholder="Décrivez l'événement, le contexte, les règles de participation…"
                          @bind="_form.Description"></textarea>
            </div>

            @* Dates *@
            <h5 class="section-title mt-4">
                <i class="bi bi-calendar-event me-2"></i>Dates
            </h5>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="event-start">
                        Date de début <span class="text-danger">*</span>
                    </label>
                    <input id="event-start"
                           type="datetime-local"
                           class="form-control @(ShowError("StartDate") ? "is-invalid" : "")"
                           @bind="_form.StartDate" />
                    @if (ShowError("StartDate"))
                    {
                        <div class="invalid-feedback">La date de début est obligatoire.</div>
                    }
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-semibold" for="event-end">
                        Date de fin <span class="text-danger">*</span>
                    </label>
                    <input id="event-end"
                           type="datetime-local"
                           class="form-control @(ShowError("EndDate") ? "is-invalid" : "")"
                           @bind="_form.EndDate" />
                    @if (ShowError("EndDate"))
                    {
                        <div class="invalid-feedback">@_fieldErrors["EndDate"]</div>
                    }
                </div>
            </div>

            @* Theme & premium *@
            <h5 class="section-title mt-4">
                <i class="bi bi-palette me-2"></i>Thème &amp; accès
            </h5>

            <div class="row g-3 mb-3">
                <div class="col-12 col-md-8">
                    <label class="form-label fw-semibold" for="event-theme">
                        Thème <span class="text-danger">*</span>
                    </label>
                    @if (_themes is null)
                    {
                        <div class="text-muted fst-italic">Chargement des thèmes…</div>
                    }
                    else
                    {
                        <select id="event-theme"
                                class="form-select @(ShowError("ThemeId") ? "is-invalid" : "")"
                                @bind="_form.ThemeId">
                            <option value="0">— Choisir un thème —</option>
                            @foreach (var t in _themes)
                            {
                                <option value="@t.Id">
                                    @(t.Icon is not null ? t.Icon + " " : "")@t.Name
                                </option>
                            }
                        </select>
                        @if (ShowError("ThemeId"))
                        {
                            <div class="invalid-feedback">Veuillez sélectionner un thème.</div>
                        }
                    }
                </div>

                <div class="col-12 col-md-4 d-flex align-items-end pb-1">
                    <div class="form-check form-switch">
                        <input id="event-premium"
                               class="form-check-input"
                               type="checkbox"
                               role="switch"
                               @bind="_form.IsPremium" />
                        <label class="form-check-label fw-semibold" for="event-premium">
                            <i class="bi bi-star-fill text-warning me-1"></i>Événement Premium
                        </label>
                    </div>
                </div>
            </div>

            @* Badges *@
            <h5 class="section-title mt-4">
                <i class="bi bi-award me-2"></i>Badges
                <span class="badge bg-secondary ms-2">@_badges.Count</span>
            </h5>
            <p class="text-muted small mb-3">
                Ajoutez les badges qui pourront être attribués aux participants de cet événement.
            </p>

            @for (int i = 0; i < _badges.Count; i++)
            {
                var idx = i; // capture pour le callback
                <BadgeItemForm Badge="_badges[idx]"
                               Index="idx"
                               OnRemove="RemoveBadge"
                               OnChange="b => UpdateBadge(idx, b)" />
            }

            <button type="button"
                    class="btn btn-outline-primary btn-sm mt-1"
                    @onclick="AddBadge">
                <i class="bi bi-plus-circle me-1"></i>Ajouter un badge
            </button>

            @* Actions *@
            <hr class="my-4" />

            <div class="d-flex justify-content-end gap-2">
                <a href="/admin/events" class="btn btn-outline-secondary">
                    Annuler
                </a>
                <button type="button"
                        class="btn btn-primary px-4"
                        disabled="@_isSubmitting"
                        @onclick="SubmitAsync">
                    @if (_isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                        <span>Création en cours…</span>
                    }
                    else
                    {
                        <i class="bi bi-check2-circle me-1"></i>
                        <span>Créer l'événement</span>
                    }
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private EventFormModel _form = new();
    private List<CreateBadgeRequest> _badges = new();

    private List<ThemeResponse>? _themes;

    private bool _isSubmitting;
    private string? _errorMessage;
    private EventResponse? _createdEvent;
    private Dictionary<string, string> _fieldErrors = new();

    // TODO : récupérer le UserId de l'auteur
    private const int AdminUserId = 1;
    
    protected override async Task OnInitializedAsync()
    {
        _themes = await ThemeSvc.GetAllAsync();
    }
    
    private void AddBadge()
        => _badges.Add(new CreateBadgeRequest(string.Empty, string.Empty));

    private void RemoveBadge(int index)
    {
        if (index >= 0 && index < _badges.Count)
            _badges.RemoveAt(index);
    }

    private void UpdateBadge(int index, CreateBadgeRequest updated)
        => _badges[index] = updated;
    
    private async Task SubmitAsync()
    {
        _errorMessage  = null;
        _createdEvent  = null;
        _fieldErrors   = new();

        if (!Validate()) return;

        _isSubmitting = true;

        try
        {
            var request = new CreateEventRequest(
                _form.Name.Trim(),
                _form.Description.Trim(),
                _form.StartDate,
                _form.EndDate,
                _form.IsPremium,
                _form.ThemeId,
                AdminUserId,
                _badges
            );

            _createdEvent = await EventSvc.CreateAsync(request);
            
            await Task.Delay(1500);
            Nav.NavigateTo($"/admin/events/{_createdEvent.Id}");
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
    
    private bool Validate()
    {
        if (string.IsNullOrWhiteSpace(_form.Name))
            _fieldErrors["Name"] = "Obligatoire";

        if (_form.StartDate == default)
            _fieldErrors["StartDate"] = "Obligatoire";

        if (_form.EndDate == default)
            _fieldErrors["EndDate"] = "Obligatoire";
        else if (_form.EndDate <= _form.StartDate)
            _fieldErrors["EndDate"] = "La date de fin doit être postérieure à la date de début.";

        if (_form.ThemeId == 0)
            _fieldErrors["ThemeId"] = "Obligatoire";

        return _fieldErrors.Count == 0;
    }

    private bool ShowError(string field) => _fieldErrors.ContainsKey(field);
    
    private class EventFormModel
    {
        public string   Name        { get; set; } = string.Empty;
        public string   Description { get; set; } = string.Empty;
        public DateTime StartDate   { get; set; }
        public DateTime EndDate     { get; set; }
        public bool     IsPremium   { get; set; }
        public int      ThemeId     { get; set; }
    }
}
