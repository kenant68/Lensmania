@page "/forgot-password"
@using LensmaniaClient.Models.Auth
@using LensmaniaClient.Services.Auth
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthCard>
    @if (!submitted)
    {
        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div class="auth-fields">
                <div class="auth-field">
                    <label class="visually-hidden" for="forgot-email">E-mail</label>
                    <input id="forgot-email" class="form-control auth-input" type="email" autocomplete="email" placeholder="Email" @bind="email" @bind:event="oninput" />
                </div>
            </div>

            <button class="auth-submit" type="submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Envoi…</span>
                }
                else
                {
                    <span>Envoyer le lien</span>
                }
            </button>

            <p class="auth-footer-link">
                <a href="@AuthRoutes.Login">Retour à la connexion</a>
            </p>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="auth-alert auth-alert--error" role="alert">
                    @message
                </div>
            }
        </form>
    }
    else
    {
        <div class="auth-alert auth-alert--success" role="status">
            Si l'adresse correspond à un compte, un lien de réinitialisation a été envoyé.
        </div>
        <p class="auth-footer-link">
            <a href="@AuthRoutes.Login">Retour à la connexion</a>
        </p>
    }
</AuthCard>

@code {
    private string email = string.Empty;
    private bool isLoading;
    private bool submitted;
    private string? message;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/");
    }

    private async Task SubmitAsync()
    {
        var trimmedEmail = email.Trim();
        if (string.IsNullOrWhiteSpace(trimmedEmail))
        {
            message = "L'adresse e-mail est obligatoire.";
            return;
        }
        if (!(new System.ComponentModel.DataAnnotations.EmailAddressAttribute()).IsValid(trimmedEmail))
        {
            message = "L'adresse e-mail n'est pas valide.";
            return;
        }

        message = null;
        isLoading = true;
        StateHasChanged();

        var result = await AuthApiClient.ForgotPasswordAsync(new ForgotPasswordRequestDto(trimmedEmail));
        isLoading = false;

        if (result.IsSuccess)
        {
            submitted = true;
        }
        else
        {
            message = result.Error?.Message ?? "L'envoi du lien a échoué.";
        }
    }
}
