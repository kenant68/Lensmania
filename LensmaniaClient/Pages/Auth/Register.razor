@page "/register"
@using LensmaniaClient.Components
@using LensmaniaClient.Models.Auth
@using LensmaniaClient.Services.Auth
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<AuthCard>
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
        <div class="auth-fields auth-fields--before-submit-only">
            <div class="auth-field">
                <label class="visually-hidden" for="reg-username">Nom d'utilisateur</label>
                <input id="reg-username" class="form-control auth-input" autocomplete="username" placeholder="Nom d'utilisateur" @bind="username" @bind:event="oninput" />
            </div>
            <div class="auth-field">
                <label class="visually-hidden" for="reg-email">E-mail</label>
                <input id="reg-email" class="form-control auth-input" type="email" autocomplete="email" placeholder="Email" @bind="email" @bind:event="oninput" />
            </div>
            <div class="auth-field">
                <label class="visually-hidden" for="reg-password">Mot de passe</label>
                <input id="reg-password" class="form-control auth-input" type="password" autocomplete="new-password" placeholder="Mot de passe" @bind="password" @bind:event="oninput" />
            </div>
            <div class="auth-field">
                <label class="visually-hidden" for="reg-password-confirmation">Confirmation du mot de passe</label>
                <input id="reg-password-confirmation" class="form-control auth-input" type="password" autocomplete="new-password" placeholder="Confirmer le mot de passe" @bind="confirmPassword" @bind:event="oninput" />
            </div>
        </div>

        <button class="auth-submit" type="submit" disabled="@isLoading">
            @if (isLoading)
            {
                <span>Inscription…</span>
            }
            else
            {
                <span>Inscription</span>
            }
        </button>

        <p class="auth-footer-link">
            Déjà un compte ?
            <a href="@AuthRoutes.Login">Se connecter</a>
        </p>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="auth-alert @(isError ? "auth-alert--error" : "auth-alert--success")" role="alert">
                @message
            </div>
        }
    </form>

    <div class="auth-separator"><span>ou</span></div>
    <GoogleSignInButton />
</AuthCard>

@code {
    private string username = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string confirmPassword = string.Empty;
    private bool isLoading;
    private string? message;
    private bool isError;

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/");
    }

    private async Task SubmitAsync()
    {
        message = null;
        isError = false;

        var validationMessage = ValidateForm();
        if (validationMessage is not null)
        {
            isError = true;
            message = validationMessage;
            return;
        }

        isLoading = true;
        StateHasChanged();

        var result = await AuthApiClient.RegisterAsync(
            new RegisterRequestDto(username.Trim(), email.Trim(), password));

        if (result.IsSuccess && result.Data is not null)
        {
            isError = false;
            message = $"Compte créé. Bienvenue, {result.Data.Username}.";
            await Task.Delay(150);
            Navigation.NavigateTo("/");
            return;
        }

        isError = true;
        message = result.Error?.Message ?? "L'inscription a échoué.";
        isLoading = false;
    }

    private string? ValidateForm()
    {
        var trimmedUsername = username.Trim();
        var trimmedEmail = email.Trim();

        if (string.IsNullOrWhiteSpace(trimmedUsername))
            return "Le nom d'utilisateur est obligatoire.";

        if (trimmedUsername.Length < 3)
            return "Le nom d'utilisateur doit contenir au moins 3 caracteres.";

        if (trimmedUsername.Length > 32)
            return "Le nom d'utilisateur ne peut pas depasser 32 caracteres.";

        if (string.IsNullOrWhiteSpace(trimmedEmail))
            return "L'adresse e-mail est obligatoire.";

        if (trimmedEmail.Length > 254)
            return "L'adresse e-mail ne peut pas depasser 254 caracteres.";

        if (!(new System.ComponentModel.DataAnnotations.EmailAddressAttribute()).IsValid(trimmedEmail))
            return "L'adresse e-mail n'est pas valide.";

        if (string.IsNullOrWhiteSpace(password))
            return "Le mot de passe est obligatoire.";

        if (password.Length < 8)
            return "Le mot de passe est trop court (minimum 8 caracteres).";

        if (password.Length > 128)
            return "Le mot de passe ne peut pas depasser 128 caracteres.";

        if (string.IsNullOrWhiteSpace(confirmPassword))
            return "La confirmation du mot de passe est obligatoire.";

        if (!string.Equals(password, confirmPassword, StringComparison.Ordinal))
            return "Les mots de passe ne correspondent pas.";

        return null;
    }
}
