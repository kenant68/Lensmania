@page "/reset-password"
@using LensmaniaClient.Models.Auth
@using LensmaniaClient.Services.Auth
@using Microsoft.AspNetCore.WebUtilities
@inject AuthApiClient AuthApiClient
@inject NavigationManager Navigation

<AuthCard>
    @if (string.IsNullOrWhiteSpace(token))
    {
        <div class="auth-alert auth-alert--error" role="alert">
            Lien invalide. Demandez un nouveau lien de réinitialisation.
        </div>
        <p class="auth-footer-link">
            <a href="@AuthRoutes.ForgotPassword">Demander un nouveau lien</a>
        </p>
    }
    else if (!completed)
    {
        <form @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div class="auth-fields">
                <div class="auth-field">
                    <label class="visually-hidden" for="reset-password">Nouveau mot de passe</label>
                    <input id="reset-password" class="form-control auth-input" type="password" autocomplete="new-password" placeholder="Nouveau mot de passe" @bind="newPassword" @bind:event="oninput" />
                </div>
                <div class="auth-field">
                    <label class="visually-hidden" for="reset-password-confirmation">Confirmation</label>
                    <input id="reset-password-confirmation" class="form-control auth-input" type="password" autocomplete="new-password" placeholder="Confirmer le mot de passe" @bind="confirmPassword" @bind:event="oninput" />
                </div>
            </div>

            <button class="auth-submit" type="submit" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Mise à jour…</span>
                }
                else
                {
                    <span>Mettre à jour le mot de passe</span>
                }
            </button>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="auth-alert @(isError ? "auth-alert--error" : "auth-alert--success")" role="alert">
                    @message
                </div>
            }

            @if (showRequestNewLink)
            {
                <p class="auth-footer-link">
                    <a href="@AuthRoutes.ForgotPassword">Demander un nouveau lien</a>
                </p>
            }
        </form>
    }
    else
    {
        <div class="auth-alert auth-alert--success" role="status">
            Mot de passe modifié. Redirection…
        </div>
    }
</AuthCard>

@code {
    private string? token;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private bool isLoading;
    private bool completed;
    private bool isError;
    private bool showRequestNewLink;
    private string? message;

    protected override void OnInitialized()
    {
        var uri = Navigation.ToAbsoluteUri(Navigation.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("token", out var rawToken))
        {
            token = rawToken.ToString();
        }
    }

    private async Task SubmitAsync()
    {
        var validation = ValidateForm();
        if (validation is not null)
        {
            isError = true;
            showRequestNewLink = false;
            message = validation;
            return;
        }

        message = null;
        isError = false;
        isLoading = true;
        StateHasChanged();

        var result = await AuthApiClient.ResetPasswordAsync(new ResetPasswordRequestDto(token!, newPassword));
        isLoading = false;

        if (result.IsSuccess)
        {
            completed = true;
            StateHasChanged();
            await Task.Delay(1500);
            Navigation.NavigateTo("/login");
            return;
        }

        isError = true;
        message = result.Error?.Message ?? "La mise à jour du mot de passe a échoué.";
        showRequestNewLink = result.Error?.Type == AuthApiErrorType.InvalidOrExpiredResetToken;
    }

    private string? ValidateForm()
    {
        if (string.IsNullOrWhiteSpace(newPassword))
            return "Le mot de passe est obligatoire.";

        if (newPassword.Length < 8)
            return "Le mot de passe est trop court (minimum 8 caractères).";

        if (newPassword.Length > 128)
            return "Le mot de passe ne peut pas dépasser 128 caractères.";

        if (string.IsNullOrWhiteSpace(confirmPassword))
            return "La confirmation du mot de passe est obligatoire.";

        if (!string.Equals(newPassword, confirmPassword, StringComparison.Ordinal))
            return "Les mots de passe ne correspondent pas.";

        return null;
    }
}
