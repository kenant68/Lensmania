@page "/"
@layout HomeLayout

<PageTitle>Lensmania — Capturez votre monde</PageTitle>

<section class="hero-features">
    <div class="hero">
        <div class="hero-text">
            <h1 class="brand-heading">Lensmania <img src="svg/logo.svg" alt="logo" class="brand-icon" /></h1>
            <h2 class="hero-title">Capturez votre monde</h2>
            <p>Lensmania transforme vos photos en souvenirs intemporels.</p>
            <p>Prenez vos photos et partagez-les avec les utilisateurs.</p>
        </div>
        <div class="hero-illustration">
            <img src="svg/main.svg" alt="Illustration photos" />
        </div>
    </div>

    <div class="features">
        <div class="feature-item">
            <img src="svg/logo.svg" alt="Photographie" class="feature-icon" />
            <h3>La photographie pour tous</h3>
            <p>Professionnel comme amateur postez vos meilleures photos</p>
        </div>
        <div class="feature-item">
            <img src="svg/podium.svg" alt="Classement" class="feature-icon" />
            <h3>Classement</h3>
            <p>Les meilleurs photos seront affichées dans le classement général, démarquez vous :)</p>
        </div>
        <div class="feature-item">
            <img src="svg/events.svg" alt="Évènements" class="feature-icon" />
            <h3>Evènements</h3>
            <p>Participez à des évènements et tentez de gagner des récompenses</p>
        </div>
    </div>
</section>

<section class="cta-section">
    <h2>Prêt à capturer le monde ?</h2>
    <a href="posts" class="btn btn-cta">Rejoindre en tant qu'Invité</a>
</section>
