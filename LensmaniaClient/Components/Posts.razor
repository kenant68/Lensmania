@using Soenneker.Blazor.Masonry
@using LensmaniaClient.Components
@using LensmaniaLibrary.Enums

@if (ShowSortToggle)
{
    <div class="sort-toggle">
        <select class="sort-select" aria-label="Trier les posts" value="@_sortOrder.ToString()" @onchange="OnSortChanged">
            <option value="DateDesc">Récents ↓</option>
            <option value="DateAsc">Anciens ↑</option>
            <option value="LikesDesc">Plus likés ↓</option>
            <option value="LikesAsc">Moins likés ↑</option>
        </select>
    </div>
}

@if (DisplayCreateButton)
{
    <AuthorizeView>
        <Authorized>
            <CreatePostButton OnPostCreated="HandlePostCreated" EventId="@EventId" />
        </Authorized>
        <NotAuthorized>
            <p class="text-center mb-4">Connectez-vous pour publier !</p>
        </NotAuthorized>
    </AuthorizeView>
}

@if (_hasError && !_posts.Any()) {
	<p class="error">@_errorMessage</p>
}
else if (!_posts.Any() && _isLoading) {
    <p>Chargement...</p>
}
else if (!_posts.Any()) {
    <p>Aucune photo pour l'instant.</p>
}
else {
	<Masonry AutoRender="false" SizerClass="col-sm-1" @ref="_masonry" class="row">
        @foreach (var post in _posts)
        {
            <MasonryItem class="col-lg-3 col-md-4 col-sm-6 mb-4">
                <div class="post-card">
                    
                    <div @onclick="() => SelectPost(post)">
                        <img src="@($"{ApiBaseUrl}/uploads/photos/{post.PhotoUrl}")"
                             alt="@post.Title"
                             class="card-img-top"
                             @onload="OnImageLoaded"
                             @onerror="OnImageFailed"/>
                    </div>
                    
                    <div class="post-overlay">
                        <button type="button"
                                class="like-btn @(post.IsLikedByCurrentUser ? "liked" : "")"
                                aria-label="@(post.IsLikedByCurrentUser ? "Retirer le like" : "Liker la photo")"
                                aria-pressed="@post.IsLikedByCurrentUser"
                                @onclick="() => ToggleLike(post)"
                                @onclick:stopPropagation="true">
                            <span class="heart-icon">@(post.IsLikedByCurrentUser ? "♥" : "♡")</span>
                            <span class="like-count">@FormatLikeCount(post.LikesCount)</span>
                        </button>
                    </div>

                    @if (_selectedPostItem?.Id == post.Id)
                    {
                        <div class="post-detail" @onclick:stopPropagation="true">
                            <button class="btn btn-primary ms-auto w-25" @onclick="CloseDetail">✕</button>

                            @if (_isLoadingDetail)
                            {
                                <p>Chargement...</p>
                            }
                            else if (_selectedPostDetailed is not null)
                            {
                                <span>@_selectedPostDetailed.Title</span>
                                <p class="small fw-light opacity-75">@_selectedPostDetailed.Description</p>

                                <p>
                                    <NavLink class="nav-link fw-semibold" href=@($"/profile/{_selectedPostDetailed.Username}")> Par @_selectedPostDetailed.Username</NavLink>
                                </p>

                                <p class="small fw-light opacity-75">@_selectedPostDetailed.CreatedAt.ToShortDateString()</p>

                                <AuthorizeView>
                                    <Authorized>
                                        @if (IsOwnProfile)
                                        {
                                            <DeletePostButton
                                                PostId="@post.Id"
                                                OnPostDeleted="HandlePostDeleted"/>
                                        }
                                    </Authorized>
                                </AuthorizeView>
                            }
                        </div>
                    }
                </div>
            </MasonryItem>
        }
    </Masonry>
}

@if (_hasError && _posts.Any()) {
	<p class="error">@_errorMessage</p>
}

@if (!_hasMore && _posts.Any()) {
	<p class="text-center mb-4">Vous avez vu tous les posts</p>
}

@if (_hasMore) {
    <div @ref="_sentinel" style="height: 1px;"></div>
}
