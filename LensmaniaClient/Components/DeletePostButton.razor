@using LensmaniaLibrary.DTOs.Posts

<button class="btn btn-danger btn-sm" @onclick="OpenModal">
    Supprimer
</button>

<DeletePostModal
    IsOpen="@isModalOpen"
    PostId="@PostId"
    OnClose="CloseModal"
    OnPostDeleted="OnPostDeleted"
/>

@code {
    [Parameter, EditorRequired] public int PostId { get; set; }
    [Parameter] public EventCallback<int> OnPostDeleted { get; set; }

    private bool isModalOpen = false;

    void OpenModal() => isModalOpen = true;
    void CloseModal() => isModalOpen = false;
}
